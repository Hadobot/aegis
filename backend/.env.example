# Upstream LLM (the real API Aegis proxies to)
# Using OpenRouter - routes to 200+ models via single endpoint
UPSTREAM_LLM_BASE_URL=https://openrouter.ai/api/v1
UPSTREAM_LLM_API_KEY=sk-or-v1-your-openrouter-key-here

# Default model for OpenRouter (used in requests)
OPENROUTER_DEFAULT_MODEL=google/gemini-2.0-flash-001

# Or use OpenAI directly
# UPSTREAM_LLM_BASE_URL=https://api.openai.com
# UPSTREAM_LLM_API_KEY=sk-your-real-key-here

# Or use Google Gemini directly
# UPSTREAM_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# UPSTREAM_LLM_API_KEY=your-google-key

# Aegis internal - LLM for agent classification (Sentry/Shield)
# Defaults to OpenRouter if not set separately
INTERNAL_LLM_API_KEY=${UPSTREAM_LLM_API_KEY}
INTERNAL_LLM_BASE_URL=${UPSTREAM_LLM_BASE_URL}
INTERNAL_LLM_MODEL=${OPENROUTER_DEFAULT_MODEL}

# Vector Store
QDRANT_HOST=qdrant
QDRANT_PORT=6333
ENVIRONMENT=development
